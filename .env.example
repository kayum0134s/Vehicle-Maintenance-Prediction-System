# =============================================================================
# Vehicle Maintenance Prediction System (VMPS)
# Environment Variables Example
#
# IMPORTANT:
# - Copy this file to .env for local development.
# - In Vercel, add these variables in: Project Settings -> Environment Variables.
# - NEVER commit sensitive credentials or real passwords to source control.
# =============================================================================

# Flask Secret Key (Required for sessions; use a strong random string)
SECRET_KEY=your-secure-random-secret-key-min-32-chars

# Database Connection (Supabase PostgreSQL)
# For Supabase Transaction Pooler (recommended for Vercel serverless, port 6543):
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# For Direct Connection (port 5432):
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# For Local SQLite (development only, when DATABASE_URL is left empty):
DATABASE_URL=postgresql://postgres.yfpuabesfrusflnngupx:Kayum%402292004@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Flask Environment (Set to 'production' on Vercel or leave VERCEL=1)
# DEBUG=False in production
DEBUG=False

# Serverless Connection Pool Tuning (Optional, conservative defaults provided)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
